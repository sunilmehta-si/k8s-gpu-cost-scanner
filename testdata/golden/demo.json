  "findings": [
    {
      "rule": "GPU005",
      "slug": "excess-replicas",
      "title": "More replicas than the peak load needed",
      "severity": "high",
      "target": "ml/Deployment/llama-70b",
      "namespace": "ml",
      "pods": [
        "llama-70b-7c9d8f-axkqz",
        "llama-70b-7c9d8f-bxkrz",
        "llama-70b-7c9d8f-cxksz"
      ],
      "evidence": [
        "ran up to 3 replicas of meta-llama/Llama-3.3-70B-Instruct",
        "the KV cache in use across all replicas peaked at 105.0% of one replica's cache",
        "at most 2 replicas were needed to keep each under 80.0% KV use, at the busiest step",
        "no request waited in a queue at any replica"
      ],
      "waste_gpu_hours": 96.33333333333304,
      "waste_cost": 385.3333333333322,
      "priced": true,
      "recommendation": "Cap the workload at 2 replicas, or let an autoscaler follow the load: scale on KV cache use or requests in the system, which track an LLM server's capacity, not on CPU. Keep a replica of headroom if the peak in this window was not the busiest you expect."
    },
    {
      "rule": "GPU004",
      "slug": "stranded-gpus",
      "title": "GPUs no pod requested",
      "severity": "high",
      "target": "node/gpu-h100-b",
      "node": "gpu-h100-b",
      "evidence": [
        "offered 192.7 GPU-hours (8 GPUs at most); pods requested 132.6 GPU-hours, 5.5 GPUs on average",
        "31.2% of the node's GPU time (60.1 GPU-hours) no pod requested"
      ],
      "waste_gpu_hours": 60.083333333333115,
      "waste_cost": 240.33333333333246,
      "priced": true,
      "recommendation": "Let the cluster autoscaler remove the node or shrink its node pool when GPUs sit unrequested, or pack GPU pods onto fewer nodes: KAI Scheduler bin-packs GPUs by default; Volcano needs its binpack plugin weighted for nvidia.com/gpu; the default scheduler needs MostAllocated scoring for it. If pods are pending at the same time, the free GPUs are split across nodes in pieces too small for them."
    },
    {
      "rule": "GPU002",
      "slug": "no-traffic",
      "title": "Model served no traffic",
      "severity": "high",
      "target": "ml/Deployment/legacy-mistral",
      "namespace": "ml",
      "pods": [
        "legacy-mistral-7c9d8f-axkqz"
      ],
      "node": "gpu-l4-a",
      "evidence": [
        "held 1 GPU for 24.1 hours of the window",
        "vLLM (mistralai/Mistral-7B-Instruct-v0.3) finished 0 requests and generated 0 tokens in the window",
        "GPU activity averaged 0.0%"
      ],
      "waste_gpu_hours": 24.08333333333326,
      "waste_cost": 16.85833333333328,
      "priced": true,
      "recommendation": "Scale the model to zero while nothing calls it (KServe minReplicas: 0, a KEDA ScaledObject with minReplicaCount: 0, or Knative), or remove it if nothing should. Check first that clients are not failing to reach it: a broken route also shows as no traffic."
    },
    {
      "rule": "GPU001",
      "slug": "idle-gpu",
      "title": "GPUs held but never used",
      "severity": "high",
      "target": "research/Pod/notebook-ana",
      "namespace": "research",
      "pods": [
        "notebook-ana"
      ],
      "node": "gpu-h100-b",
      "evidence": [
        "held 1 GPU for 24.1 hours of the window",
        "GPU activity: average 0.0%, 95th percentile 0.0%, peak 0.0% (DCGM, 100.0% of the time measured)",
        "average power draw 60 W across its GPUs",
        "GPU memory peaked at 2.0% of capacity: something was loaded, nothing ran on it"
      ],
      "waste_gpu_hours": 24.08333333333326,
      "waste_cost": 96.33333333333304,
      "priced": true,
      "recommendation": "Find out why the pod holds GPUs it does not use (a finished job waiting to be cleaned up, a notebook left running, a GPU request on a container that needs none) and release them: delete the pod, set a TTL on finished Jobs, or cull idle notebooks."
    },
    {
      "rule": "GPU003",
      "slug": "engine-asleep",
      "title": "Engine asleep while holding GPUs",
      "severity": "medium",
      "target": "rl/Deployment/policy-server",
