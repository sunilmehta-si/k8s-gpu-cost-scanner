    "pod_gpu_requests": "sum by (namespace, pod, node, resource) (max by (namespace, pod, container, node, resource) (kube_pod_container_resource_requests{resource=~\"nvidia_com_gpu|nvidia_com_mig_.+\"})) * on (namespace, pod) group_left () (max by (namespace, pod) (kube_pod_status_phase{phase=\"Running\"}) == 1)",
    "pod_owner": "max by (namespace, pod, owner_kind, owner_name) (last_over_time(kube_pod_owner{owner_is_controller=\"true\"}[86400s]))",
    "replicaset_owner": "max by (namespace, replicaset, owner_kind, owner_name) (last_over_time(kube_replicaset_owner[86400s]))",
    "vllm_awake": "vllm:engine_sleep_state{sleep_state=\"awake\"}",
    "vllm_generation_tokens": "increase(vllm:generation_tokens_total[86400s])",
    "vllm_kv_usage": "vllm:kv_cache_usage_perc",
    "vllm_prompt_tokens": "increase(vllm:prompt_tokens_total[86400s])",
    "vllm_requests": "sum without (finished_reason) (increase(vllm:request_success_total[86400s]))",
    "vllm_running": "vllm:num_requests_running",
    "vllm_waiting": "vllm:num_requests_waiting"
